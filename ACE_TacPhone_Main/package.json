{
  "name": "ace-tacphone-main",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode release && tacphone-build check-shared-imports",
    "build:debug": "tsc -b && vite build --mode debug && tacphone-build check-shared-imports",
    "check:importmap": "tacphone-build check-shared-imports",
    "check": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ace-tacphone/api": "*",
    "dockview-react": "^7.0.3",
    "flexlayout-react": "^0.10.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@ace-tacphone/build": "*",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
