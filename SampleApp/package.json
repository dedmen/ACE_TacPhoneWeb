{
  "name": "ace-tacphone-sampleapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "tacphone": {
    "app": "SampleApp"
  },
  "main": "./dist/ace_tacphone_sampleapp.js",
  "types": "./dist/ace_tacphone_sampleapp.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/ace_tacphone_sampleapp.d.ts",
        "default": "./dist/ace_tacphone_sampleapp.js"
      }
    }
  },
  "scripts": {
    "dev": "npm --prefix ../ACE_TacPhone_Main run dev --",
    "build": "tsc -b && vite build --mode release && tacphone-build check-shared-imports && tacphone-build bundle-api-types --app . --entry src/api.ts --name SampleApp",
    "build:debug": "tsc -b && vite build --mode debug && tacphone-build check-shared-imports && tacphone-build bundle-api-types --app . --entry src/api.ts --name SampleApp",
    "check:importmap": "tacphone-build check-shared-imports",
    "check": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@ace-tacphone/api": "*",
    "@ace-tacphone/build": "*",
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "micromatch": "^4.0.8",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rollup": "^4.62.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-lib-inject-css": "^2.2.2"
  }
}
